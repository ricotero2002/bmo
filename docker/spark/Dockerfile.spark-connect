# docker/spark/Dockerfile.spark-connect
FROM apache/spark:3.5.1

# Usuario root para instalar dependencias y crear carpetas
USER root

# Pre-descargar JARs en el build para eliminar el tiempo de descarga en runtime
# El pod arrancará en ~15s en lugar de ~120s
RUN /opt/spark/bin/spark-class org.apache.spark.deploy.SparkSubmit \
    --packages "org.apache.spark:spark-connect_2.12:3.5.1,\
org.apache.iceberg:iceberg-spark-runtime-3.5_2.12:1.5.2,\
org.apache.iceberg:iceberg-aws-bundle:1.5.2,\
org.apache.hadoop:hadoop-aws:3.3.4,\
com.amazonaws:aws-java-sdk-bundle:1.12.262" \
    --conf "spark.jars.ivy=/opt/spark/.ivy2" \
    --dry-run 2>/dev/null || true

# Hacer que los JARs descargados sean legibles para el usuario spark
RUN chmod -R 755 /opt/spark/.ivy2

# Volver al usuario spark por seguridad
USER spark

ENV SPARK_EXTRA_CLASSPATH="/opt/spark/.ivy2/cache/*"
